{
  "name": "yuanmingyuan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 ../../tools/export_web_data.py",
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
